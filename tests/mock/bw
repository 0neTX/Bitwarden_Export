#!/usr/bin/env bash
# Stateful mock of the Bitwarden CLI.
#   BW_STATE      : file holding the CLI's persisted state (~/.config/Bitwarden CLI/data.json)
#   BW_REAL_PW    : the master password the *server* currently accepts
#   BW_FAIL_CONFIG/BW_FAIL_LOGIN : force those subcommands to fail
#   BW_FAIL_EXPORT : "personal" or an organization id whose export fails
#   BW_FAIL_LIST   : "organizations" or "items", a listing that fails
#   BW_ORGS_JSON   : what "list organizations" prints (default: [])
#   BW_DENY_EXPORT : an organization id the server refuses to export (a 401)
#   BW_EXPORT_PWLOG: file that records, per export, the password the CLI received
#   BW_EXPORT_NOFILE: "personal" or an organization id whose export exits 0 unwritten
STATE="${BW_STATE:?}"
LOG="${BW_CALLLOG:-/dev/null}"
echo "bw $*" >> "$LOG"
echo "APPDATA=[${BITWARDENCLI_APPDATA_DIR-<UNSET>}]" >> "$LOG"

auth=0; locked=1; cached_pw=""; server="https://vault.bitwarden.com"
# shellcheck disable=SC1090
[ -f "$STATE" ] && . "$STATE"

save() { printf 'auth=%s\nlocked=%s\ncached_pw=%q\nserver=%q\n' "$auth" "$locked" "$cached_pw" "$server" > "$STATE"; }

case "$1" in
  status)
    if   [ "$auth" = 0 ];   then st=unauthenticated
    elif [ "$locked" = 1 ]; then st=locked
    else                         st=unlocked; fi
    printf '{"serverUrl":"%s","status":"%s"}\n' "$server" "$st"; exit 0 ;;

  config)
    [ -n "$BW_FAIL_CONFIG" ] && { echo "mock: config rejected" >&2; exit 1; }
    # Real CLI refuses to change the server while an account is present.
    if [ "$auth" = 1 ]; then echo "Logout required before server config update." >&2; exit 1; fi
    server="$3"; save; echo "Saved setting \`config\`."; exit 0 ;;

  login)
    [ -n "$BW_FAIL_LOGIN" ] && { echo "mock: login failed" >&2; exit 1; }
    if [ "$auth" = 1 ]; then echo "You are already logged in" >&2; exit 1; fi
    auth=1; locked=1; cached_pw="${BW_REAL_PW:?}"; save; exit 0 ;;

  unlock)
    if [ "$auth" = 0 ];   then echo "You are not logged in." >&2; exit 1; fi
    if [ "$locked" = 0 ]; then echo "Vault is already unlocked." >&2; exit 1; fi
    # The CLI validates the password against its *cached* profile, not the server.
    # Like the real CLI: --passwordenv VAR, --passwordfile PATH (first line), or
    # the password itself as the first argument.
    case "$2" in
      --passwordenv)  pw="${!3}" ;;
      --passwordfile) IFS= read -r pw < "$3" ;;
      *)              pw="$2" ;;
    esac
    if [ "$pw" != "$cached_pw" ]; then echo "Invalid master password." >&2; exit 1; fi
    locked=0; save; echo "mock-session-key-$$"; exit 0 ;;

  lock)   [ -n "$BW_FAIL_LOGOUT" ] && exit 1
          [ "$auth" = 0 ] && { echo "not logged in" >&2; exit 1; }; locked=1; save; exit 0 ;;
  logout) [ -n "$BW_FAIL_LOGOUT" ] && { echo "mock: logout refused" >&2; exit 1; }
          [ "$auth" = 0 ] && { echo "You are not logged in." >&2; exit 1; }
          auth=0; locked=1; cached_pw=""; server="https://vault.bitwarden.com"; save; exit 0 ;;

  list)
    [ "$auth" = 1 ] || { echo "You are not logged in." >&2; exit 1; }
    [ "$locked" = 0 ] || { echo "Vault is locked." >&2; exit 1; }
    # BW_FAIL_LIST names a listing (organizations, items) that fails the way it
    # does once a 401 has logged the CLI out.
    if [ -n "${BW_FAIL_LIST:-}" ] && [ "$2" = "$BW_FAIL_LIST" ] && [ "$3" != --trash ]; then
      echo "You are not logged in." >&2; exit 1
    fi
    # "list items --trash" is a different question; only the vault listing is seeded.
    if [ "$2" = organizations ] && [ -n "${BW_ORGS_JSON:-}" ]; then
      printf '%s\n' "$BW_ORGS_JSON"; exit 0
    fi
    if [ "$2" = items ] && [ "$3" != --trash ] && [ -s "${BW_ITEMS_FILE:-}" ]; then
      cat "$BW_ITEMS_FILE"
    else
      echo '[]'
    fi
    exit 0 ;;

  get)
    # bw get attachment <fileName> --itemid <id> --output <dir>
    # Records argv verbatim so a test can prove nothing was shell-expanded.
    [ "$locked" = 0 ] || { echo "Vault is locked." >&2; exit 1; }
    if [ "$2" = attachment ]; then
      file="$3"
      while [ $# -gt 0 ]; do
        case "$1" in --itemid) itemid="$2"; shift;; --output) out="$2"; shift;; esac
        shift
      done
      printf 'ATTACHMENT\t%s\t%s\t%s\n' "$itemid" "$file" "$out" >> "${BW_ATTACHLOG:-/dev/null}"
      # BW_FAIL_ATTACH names a fileName whose download fails, the way it does
      # when a proxy answers /attachments/ with a login page: message, exit 1,
      # nothing written.
      if [ -n "${BW_FAIL_ATTACH:-}" ] && [ "$file" = "$BW_FAIL_ATTACH" ]; then
        echo "An error occurred while saving the attachment." >&2
        exit 1
      fi
      mkdir -p "$out" && printf 'attachment-content\n' > "$out/$file"
      # Like the real CLI: the confirmation has no trailing newline.
      printf 'Saved %s' "${out%/}/$file"
    fi
    exit 0 ;;
  export)
    [ "$auth" = 1 ] || { echo "You are not logged in." >&2; exit 1; }
    [ "$locked" = 0 ] || { echo "Vault is locked." >&2; exit 1; }
    [ -n "$BW_SLOW_EXPORT" ] && sleep 5
    org=personal; pw=; prompt=
    for a in "$@"; do
      [ "$prev" = "--output" ] && out="$a"
      [ "$prev" = "--organizationid" ] && org="$a"
      [ "$prev" = "--password" ] && case "$a" in --*) prompt=1 ;; *) pw="$a" ;; esac
      prev="$a"
    done
    [ "$prev" = "--password" ] && prompt=1
    # --password with no value: the real CLI prompts on stderr, redrawing the line
    # once per character, and reads stdin. An empty read exits 0, nothing written.
    if [ -n "$prompt" ]; then
      IFS= read -r pw || [ -n "$pw" ] || exit 0
      for ((i = 0; i <= ${#pw}; i++)); do printf '? Export file password: [input is hidden] ' >&2; done
      echo >&2
    fi
    printf '%s\t%s\n' "$org" "$pw" >> "${BW_EXPORT_PWLOG:-/dev/null}"
    # BW_DENY_EXPORT names an organization the account may not export. The
    # server answers 401 and the real CLI then logs itself out, so every later
    # command fails with "You are not logged in."
    if [ -n "${BW_DENY_EXPORT:-}" ] && [ "$org" = "$BW_DENY_EXPORT" ]; then
      echo '{"response":{"error":{"code":401,"reason":"Unauthorized"}},"statusCode":401}' >&2
      auth=0; locked=1; cached_pw=""; save
      echo "You are not logged in." >&2; exit 1
    fi
    # BW_FAIL_EXPORT names "personal" or an organization id whose export fails
    # the way the real CLI does on an unwritable folder: one line on stderr,
    # exit 1, nothing written.
    if [ -n "${BW_FAIL_EXPORT:-}" ] && [ "$org" = "$BW_FAIL_EXPORT" ]; then
      echo "Error: EACCES: permission denied, mkdir '$out'" >&2
      exit 1
    fi
    [ -n "${BW_EXPORT_NOFILE:-}" ] && [ "$org" = "$BW_EXPORT_NOFILE" ] && exit 0
    mkdir -p "$out" && echo '{}' > "$out/export-$org.json"
    printf 'Saved %s' "${out%/}/export-$org.json"; exit 0 ;;
  *) exit 0 ;;
esac
