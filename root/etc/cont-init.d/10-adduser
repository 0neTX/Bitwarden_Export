#!/usr/bin/env bash
# Maps the container's bitwarden user onto PUID/PGID and gives it the folders it
# writes to. Runs as root, before the first export. The uid and gid it ends up
# with are logged in each run's header (entrypoint.sh, run_header).

# shellcheck disable=SC1090
. "${LOG_LIB:-/usr/local/lib/bw-export/log.sh}"

PUID=${PUID:-0}
PGID=${PGID:-0}

# Ids between 1 and 99 are typically reserved for system use.
if [[ "$PUID" -lt 100 && "$PUID" -ne 0 ]]; then
    log_warn "PUID=$PUID is below 100. Ids that low are typically reserved for system use and may cause unexpected behaviour."
fi
if [[ "$PGID" -lt 100 && "$PGID" -ne 0 ]]; then
    log_warn "PGID=$PGID is below 100. Ids that low are typically reserved for system use and may cause unexpected behaviour."
fi

groupmod -o -g "$PGID" bitwarden
usermod -o -u "$PUID" bitwarden

# Only the CLI's data folder belongs to the export user. The rest of /app is
# code that root runs (shoutrrr sends every notification as root), so a user
# that could write there could become root. Earlier versions gave all of /app
# to that user, and a container restarted rather than recreated still has it
# that way, so it is handed back to root on every start.
mkdir -p /app/data
chown root:root /app
find /app -mindepth 1 -maxdepth 1 ! -name data -exec chown -R root:root {} +
chmod 700 /app/data
chown -R bitwarden:bitwarden /app/data
# The CLI kept its state in /app itself before (data.json, and vaults/ with
# BW_VAULTS). Each run logs in afresh, so that old state is only stale tokens.
rm -rf /app/data.json /app/vaults
chown -R  bitwarden:bitwarden /var/data
chown -R  bitwarden:bitwarden /var/attachments
# Legacy mount point from the old README/compose; see bw_export.sh.
if mountpoint -q /var/attachment 2>/dev/null; then
    chown -R  bitwarden:bitwarden /var/attachment
fi
